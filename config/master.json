      "name": "検索",
      "category": "基本操作",
      "check": "名前などの言葉で検索する",
      "expected": "該当するデータだけが表示される"
    },
    {
      "name": "絞り込み",
      "category": "基本操作",
      "check": "状態などで絞り込む",
      "expected": "条件に合うデータだけが表示される"
    },
    {
      "name": "削除確認",
      "category": "基本操作",
      "check": "削除ボタンを押す",
      "expected": "確認画面が出て、キャンセルすると消えない"
    },
